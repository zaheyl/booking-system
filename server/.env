PORT=3000

# --- database ---
# Match whatever your local MySQL is actually set up with.
# db.js falls back to these same defaults if a var is missing,
# but put your real values here rather than relying on that.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=zahil1234
DB_NAME=booking_system

# --- auth ---
# Generated with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=311e0f8f46b005c935a97ac1acb0868f4bd5892a3fb0fc6400537e054c259309a639d680a8acaddd4fd709372d67cf1a
TOKEN_TTL=8h

# --- CORS ---
# Comma-separated, no spaces needed but they're trimmed if you add them.
# Add the exact origin (scheme + host + port) each site is served from.
# Adjust these ports to whatever your local server actually uses.
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5501,http://localhost:5502,http://127.0.0.1:5500,http://127.0.0.1:5501,http://127.0.0.1:5502,https://sszbook.com,https://1c256cb2.sszbook.pages.dev

